# ─────────────────────────────────────────────────────────────
#  Lie Detector App — Waitlist environment variables
#  Copy this file to `.env.local` and fill in your provider keys.
#  (.env.local is gitignored — never commit real keys.)
# ─────────────────────────────────────────────────────────────

# Which email provider the API route should use.
# Options: "resend" | "convertkit" | "mailchimp" | "formspree" | "console"
# "console" (default) just logs signups to the server console so the form
# works out-of-the-box in development with zero setup.
WAITLIST_PROVIDER=console

# ── Resend (https://resend.com) ──
# Simplest option. Create an audience and grab your API key.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ── ConvertKit (https://convertkit.com) ──
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ── Mailchimp (https://mailchimp.com) ──
# DC is the datacenter suffix in your API key, e.g. "us21".
MAILCHIMP_API_KEY=
MAILCHIMP_DC=
MAILCHIMP_AUDIENCE_ID=

# ── Formspree (https://formspree.io) ──
# Just the form hash, e.g. "xyzabcde".
FORMSPREE_FORM_ID=

# ── Optional: seed the public waitlist counter ──
# The homepage shows "X people already in line". This is the starting
# number the counter builds hype from (client-side flavor only).
NEXT_PUBLIC_WAITLIST_BASE_COUNT=18427
