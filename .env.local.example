# ─────────────────────────────────────────────────────────────
#  Lie Detector App — site environment variables
#  Copy to `.env.local` for local development. For GitHub Pages, set the
#  same names as repository *Variables* (Settings → Secrets and variables →
#  Actions → Variables); the deploy workflow passes them to the build.
#
#  Everything here is NEXT_PUBLIC_* because the site is fully static —
#  there is no server, so nothing can be secret. Only put values here that
#  are safe to ship in the page source.
# ─────────────────────────────────────────────────────────────

# Waitlist. The form posts straight from the browser to one of these.
# Option A — Formspree (https://formspree.io): create a form, paste its id.
NEXT_PUBLIC_FORMSPREE_ID=

# Option B — any endpoint that accepts a JSON POST of { email, source }
# and answers 2xx (Netlify Forms, a Cloudflare Worker, Zapier, etc.).
# If set, this wins over NEXT_PUBLIC_FORMSPREE_ID.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Where the site lives. Used for canonical URLs, Open Graph and the sitemap.
# The deploy workflow sets this automatically from GitHub Pages.
NEXT_PUBLIC_SITE_URL=https://hamzav888.github.io/lie-detector-3

# Sub-path the site is served from. Empty for a custom domain or a
# <user>.github.io repo; "/<repo-name>" for a project site. The deploy
# workflow sets this automatically — only set it locally to test a sub-path.
NEXT_PUBLIC_BASE_PATH=

# The starting point for the public waitlist counter (hype flavour only).
NEXT_PUBLIC_WAITLIST_BASE_COUNT=18427
